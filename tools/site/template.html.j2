<!doctype html>
<html lang="{{ lang.html }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<!-- Generated by tools/site/build.py from tools/site/i18n/{{ lang.code }}.json. Edit those, not this file. -->
<title>{{ t.meta_title }}</title>
<meta name="description" content="{{ t.meta_desc }}">
<meta name="theme-color" content="#121316">
<link rel="canonical" href="{{ base }}{{ lang.path }}">
{% for l in langs %}<link rel="alternate" hreflang="{{ l.html }}" href="{{ base }}{{ l.path }}">
{% endfor %}<link rel="alternate" hreflang="x-default" href="{{ base }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ t.meta_title }}">
<meta property="og:description" content="{{ t.meta_desc }}">
<meta property="og:url" content="{{ base }}{{ lang.path }}">
<meta property="og:image" content="{{ base }}assets/img/{{ og_image }}">
<meta property="og:locale" content="{{ lang.og }}">
<link rel="icon" href="{{ root }}assets/img/icon-square.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="{{ root }}icon.png">
<link rel="preload" href="{{ root }}assets/fonts/space-grotesk-bold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ root }}assets/site.css">
</head>
<body>

<a class="sr" href="#how">{{ t.skip }}</a>
<header class="top">
  <div class="wrap">
    <a class="brand" href="{{ root }}{{ lang.path }}"><img src="{{ root }}assets/img/icon-rounded.svg" alt="" width="34" height="34">ErgBeat</a>
    <nav aria-label="{{ t.nav_label }}">
      <a href="#workouts">{{ t.nav_workouts }}</a>
      <a href="#garmin">Garmin</a>
      <a href="#pro">{{ t.nav_pro }}</a>
      <a href="#faq">{{ t.nav_faq }}</a>
    </nav>
    <details class="langs">
      <summary aria-label="{{ t.lang_label }}: {{ lang.name }}">{{ lang.short }}</summary>
      <ul>
        {% for l in langs %}<li><a href="{{ root }}{{ l.path }}" hreflang="{{ l.html }}" lang="{{ l.html }}"{% if l.code == lang.code %} aria-current="page"{% endif %}>{{ l.name }}<small>{{ l.short }}</small></a></li>
        {% endfor %}
      </ul>
    </details>
  </div>
</header>

<main>
<div class="hero">
  <div class="wrap">
    <div class="hero-copy">
      <p class="label">{{ t.hero_label }}</p>
      <h1>{{ t.hero_h1 }}</h1>
      <p class="lede">{{ t.hero_lede }}</p>
      <div class="cta">
        <a class="btn btn-volt" href="{{ tester_url }}">{{ t.cta_tester }}</a>
        <a class="btn btn-ghost" href="#how">{{ t.cta_how }}</a>
      </div>
      <div class="tester"><span class="dot" aria-hidden="true"></span><p>{{ t.tester_note }}</p></div>
    </div>
    <div class="hero-visual">
      <div class="phone"><img src="{{ root }}assets/img/{{ img.live }}" width="720" height="1281" alt="{{ t.alt_live }}" fetchpriority="high"></div>
    </div>
  </div>
</div>

<div class="wrap">
  <div class="pacer">
    <svg viewBox="0 0 220 150" role="img" aria-label="{{ t.pacer_aria }}">
      <path class="arc-track" d="M 30.6 124 A 80 80 0 1 1 189.4 124" pathLength="300"/>
      <path class="arc-fill" d="M 30.6 124 A 80 80 0 1 1 189.4 124" pathLength="300"/>
      <g class="swing"><circle class="bead" cx="110" cy="30" r="12"/></g>
      <text class="spm num" x="110" y="112" text-anchor="middle">26</text>
      <text class="spm-l" x="110" y="132" text-anchor="middle">{{ t.spm }}</text>
    </svg>
    <div>
      <h2>{{ t.pacer_h2 }}</h2>
      <p>{{ t.pacer_p }}</p>
      <div class="phase"><span>{{ t.phase_drive }} ⅓</span><span>{{ t.phase_recovery }} ⅔</span></div>
    </div>
  </div>
</div>

<section id="how">
  <div class="wrap">
    <div class="head"><p class="label">{{ t.how_label }}</p><h2>{{ t.how_h2 }}</h2></div>
    <ol class="steps">
      {% for s in t.steps %}<li><h3>{{ s[0] }}</h3><p>{{ s[1] }}</p></li>
      {% endfor %}
    </ol>
  </div>
</section>

<section id="screen">
  <div class="wrap split">
    <div>
      <div class="head"><p class="label">{{ t.screen_label }}</p><h2>{{ t.screen_h2 }}</h2></div>
      <ul class="feats">
        {% for f in t.screen_feats %}<li><p><b>{{ f[0] }}</b> <span>{{ f[1] }}</span></p></li>
        {% endfor %}
      </ul>
      <div class="zones" aria-label="{{ t.zones_aria }}"><span class="chip e">{{ t.zone_easy }}</span><span class="chip z">{{ t.zone_in }}</span><span class="chip h">{{ t.zone_hard }}</span></div>
    </div>
    <div class="media col">
      <div class="landscape"><div class="phone"><img src="{{ root }}assets/img/{{ img.landscape }}" width="1100" height="507" alt="{{ t.alt_landscape }}" loading="lazy"></div></div>
    </div>
  </div>
</section>

<section id="workouts">
  <div class="wrap">
    <div class="head"><p class="label">{{ t.workouts_label }}</p><h2>{{ t.workouts_h2 }}</h2>
      <p>{{ t.workouts_p }}</p></div>
    <div class="trio">
      {% for f in t.trio %}<figure><div class="phone"><img src="{{ root }}assets/img/{{ img.trio[loop.index0] }}" width="520" height="925" alt="{{ f[2] }}" loading="lazy"></div><figcaption><b>{{ f[0] }}</b>{{ f[1] }}</figcaption></figure>
      {% endfor %}
    </div>
    <ul class="programs">
      {% for p in t.programs %}<li>{{ p[0] }}<small>{{ p[1] }}</small></li>
      {% endfor %}
    </ul>
  </div>
</section>

<section id="progress">
  <div class="wrap split rev">
    <div>
      <div class="head"><p class="label">{{ t.progress_label }}</p><h2>{{ t.progress_h2 }}</h2></div>
      <ul class="feats">
        {% for f in t.progress_feats %}<li><p><b>{{ f[0] }}</b> <span>{{ f[1] }}</span></p></li>
        {% endfor %}
      </ul>
      <div class="records num" aria-label="{{ t.records_aria }}">{% for r in t.records %}<span>{{ r }}</span>{% endfor %}</div>
    </div>
    <div class="media"><div class="phone"><img src="{{ root }}assets/img/{{ img.progress }}" width="520" height="925" alt="{{ t.alt_progress }}" loading="lazy"></div></div>
  </div>
</section>

<section id="garmin">
  <div class="wrap split">
    <div>
      <div class="head"><p class="label">Garmin</p><h2>{{ t.garmin_h2 }}</h2>
        <p>{{ t.garmin_p }}</p></div>
      <p class="models">{{ t.garmin_models }}</p>
    </div>
    <div class="watches">
      <div class="watch"><img src="{{ root }}assets/img/watch-interval.webp" width="360" height="360" alt="{{ t.alt_watch1 }}" loading="lazy"></div>
      <div class="watch"><img src="{{ root }}assets/img/watch-summary.webp" width="360" height="360" alt="{{ t.alt_watch2 }}" loading="lazy"></div>
    </div>
  </div>
</section>

<section id="devices">
  <div class="wrap">
    <div class="head"><p class="label">{{ t.devices_label }}</p><h2>{{ t.devices_h2 }}</h2></div>
    <div class="devices">
      {% for d in t.devices %}<div class="device"><span class="tag">{{ d[0] }}</span><h3>{{ d[1] }}</h3><p>{{ d[2] }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="privacy" id="privacy">
  <div class="wrap">
    <div class="head" style="margin-bottom:0"><p class="label">{{ t.privacy_label }}</p><h2>{{ t.privacy_h2 }}</h2>
      <p>{{ t.privacy_p }}</p>
      <p><a href="{{ root }}{{ privacy_href }}">{{ t.privacy_link }}</a></p></div>
    <ul class="nos">{% for n in t.nos %}<li>{{ n }}</li>{% endfor %}</ul>
  </div>
</section>

<section id="pro">
  <div class="wrap">
    <div class="head"><p class="label">{{ t.pro_label }}</p><h2>{{ t.pro_h2 }}</h2></div>
    <div class="tablewrap">
      <table>
        <thead><tr><th scope="col"><span class="sr">{{ t.th_feature }}</span></th><th scope="col">{{ t.th_free }}</th><th scope="col" class="pro">Pro</th></tr></thead>
        <tbody>
          {% for r in t.table %}<tr><td>{{ r[0] }}</td>{% for c in r[1:] %}{% if c == "y" %}<td class="y" aria-label="{{ t.yes }}">✓</td>{% elif c == "n" %}<td class="n" aria-label="{{ t.no }}">–</td>{% else %}<td>{{ c }}</td>{% endif %}{% endfor %}</tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="price">
      {% if t.price_from %}<p class="from num">{{ t.price_from }} <small>{{ t.price_plans }}</small></p>{% else %}<p class="from"><small>{{ t.price_plans }}</small></p>{% endif %}
      <p>{{ t.price_note }}</p>
    </div>
  </div>
</section>

<section id="faq">
  <div class="wrap">
    <div class="head"><p class="label">{{ t.faq_label }}</p><h2>{{ t.faq_h2 }}</h2></div>
    <div class="faq">
      {% for q in t.faq %}<details><summary>{{ q[0] }}</summary><p>{{ q[1] }}</p></details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="closing">
  <div class="wrap">
    <h2>{{ t.closing_h2 }}</h2>
    <a class="btn btn-volt" href="{{ tester_url }}">{{ t.cta_tester }}</a>
  </div>
</section>
</main>

<footer>
  <div class="wrap">
    <div class="row"><b>ErgBeat</b><span>{{ t.made_in }}</span><a href="{{ root }}{{ privacy_href }}">{{ t.privacy_short }}</a><a href="mailto:{{ email }}">{{ email }}</a></div>
    <p>{{ t.legal }}</p>
  </div>
</footer>
</body>
</html>
